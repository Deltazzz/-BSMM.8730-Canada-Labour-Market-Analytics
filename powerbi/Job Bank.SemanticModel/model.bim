{
  "name": "Job Bank",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-CA",
    "sourceQueryCulture": "en-CA",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Postings",
        "columns": [
          {
            "name": "Snapshot ID",
            "dataType": "string",
            "sourceColumn": "Snapshot ID",
            "summarizeBy": "none"
          },
          {
            "name": "First posted",
            "dataType": "string",
            "sourceColumn": "First posted",
            "summarizeBy": "none"
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none"
          },
          {
            "name": "Source",
            "dataType": "string",
            "sourceColumn": "Source",
            "summarizeBy": "none"
          },
          {
            "name": "NOC",
            "dataType": "string",
            "sourceColumn": "NOC",
            "summarizeBy": "none"
          },
          {
            "name": "Occupation",
            "dataType": "string",
            "sourceColumn": "Occupation",
            "summarizeBy": "none"
          },
          {
            "name": "Province",
            "dataType": "string",
            "sourceColumn": "Province",
            "summarizeBy": "none"
          },
          {
            "name": "Economic region",
            "dataType": "string",
            "sourceColumn": "Economic region",
            "summarizeBy": "none"
          },
          {
            "name": "Education",
            "dataType": "string",
            "sourceColumn": "Education",
            "summarizeBy": "none"
          },
          {
            "name": "Experience",
            "dataType": "string",
            "sourceColumn": "Experience",
            "summarizeBy": "none"
          },
          {
            "name": "Employment type",
            "dataType": "string",
            "sourceColumn": "Employment type",
            "summarizeBy": "none"
          },
          {
            "name": "Employment term",
            "dataType": "string",
            "sourceColumn": "Employment term",
            "summarizeBy": "none"
          },
          {
            "name": "Telework flag",
            "dataType": "string",
            "sourceColumn": "Telework flag",
            "summarizeBy": "none"
          },
          {
            "name": "Weekend flag",
            "dataType": "string",
            "sourceColumn": "Weekend flag",
            "summarizeBy": "none"
          },
          {
            "name": "Pay period",
            "dataType": "string",
            "sourceColumn": "Pay period",
            "summarizeBy": "none"
          },
          {
            "name": "Pay status",
            "dataType": "string",
            "sourceColumn": "Pay status",
            "summarizeBy": "none"
          },
          {
            "name": "Vacancies",
            "dataType": "int64",
            "sourceColumn": "Vacancies",
            "summarizeBy": "none"
          },
          {
            "name": "Lower amount",
            "dataType": "double",
            "sourceColumn": "Lower amount",
            "summarizeBy": "none"
          },
          {
            "name": "Upper amount",
            "dataType": "double",
            "sourceColumn": "Upper amount",
            "summarizeBy": "none"
          },
          {
            "name": "Midpoint amount",
            "dataType": "double",
            "sourceColumn": "Midpoint amount",
            "summarizeBy": "none"
          },
          {
            "name": "City",
            "dataType": "string",
            "sourceColumn": "City",
            "summarizeBy": "none"
          },
          {
            "name": "City and province",
            "dataType": "string",
            "sourceColumn": "City and province",
            "summarizeBy": "none"
          },
          {
            "name": "Occupation and NOC",
            "dataType": "string",
            "sourceColumn": "Occupation and NOC",
            "summarizeBy": "none"
          },
          {
            "name": "Weekly hours band",
            "dataType": "string",
            "sourceColumn": "Weekly hours band",
            "summarizeBy": "none",
            "sortByColumn": "Hours sort"
          },
          {
            "name": "Hours sort",
            "dataType": "int64",
            "sourceColumn": "Hours sort",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Dental flag",
            "dataType": "string",
            "sourceColumn": "Dental flag",
            "summarizeBy": "none"
          },
          {
            "name": "Medical flag",
            "dataType": "string",
            "sourceColumn": "Medical flag",
            "summarizeBy": "none"
          },
          {
            "name": "Evening flag",
            "dataType": "string",
            "sourceColumn": "Evening flag",
            "summarizeBy": "none"
          },
          {
            "name": "Period date",
            "dataType": "dateTime",
            "sourceColumn": "Period date",
            "summarizeBy": "none"
          },
          {
            "name": "Map province",
            "type": "calculated",
            "dataType": "string",
            "summarizeBy": "none",
            "dataCategory": "StateOrProvince",
            "expression": "SUBSTITUTE(Postings[Province],\"Québec\",\"Quebec\")"
          },
          {
            "name": "Education label",
            "type": "calculated",
            "dataType": "string",
            "summarizeBy": "none",
            "expression": "SWITCH(Postings[Education],\"Secondary (high) school graduation certificate\",\"Secondary school\",\"No degree, certificate or diploma\",\"No degree or diploma\",\"College/CEGEP\",\"College / CEGEP\",\"College, CEGEP or other non-university certificate or diploma from a program of 1 year to 2 years\",\"College, 1–2 years\",\"Other trades certificate or diploma\",\"Other trades certificate\",\"Bachelor's degree\",\"Bachelor’s degree\",\"College, CEGEP or other non-university certificate or diploma from a program of 3 months to less than 1 year\",\"College, 3–<12 months\",\"Registered Apprenticeship certificate\",\"Registered apprenticeship\",\"Degree in medicine, dentistry, veterinary medicine or optometry\",\"Professional degree\",\"Master's degree\",\"Master’s degree\",\"Earned doctorate degree\",\"Doctorate\",\"Not recorded\",\"Not recorded\",Postings[Education])"
          }
        ],
        "measures": [
          {
            "name": "Location records",
            "expression": "COUNTROWS(Postings)",
            "formatString": "#,0"
          },
          {
            "name": "Advertised openings",
            "expression": "SUM(Postings[Vacancies])",
            "formatString": "#,0"
          },
          {
            "name": "Hourly records",
            "expression": "CALCULATE(COUNT(Postings[Midpoint amount]), KEEPFILTERS(Postings[Pay period] = \"Hour\"))",
            "formatString": "#,0"
          },
          {
            "name": "Average hourly midpoint",
            "expression": "CALCULATE(AVERAGE(Postings[Midpoint amount]), KEEPFILTERS(Postings[Pay period] = \"Hour\"))",
            "formatString": "$#,0.00"
          },
          {
            "name": "Median hourly midpoint",
            "expression": "CALCULATE(MEDIAN(Postings[Midpoint amount]), KEEPFILTERS(Postings[Pay period] = \"Hour\"))",
            "formatString": "$#,0.00"
          },
          {
            "name": "Average hourly lower",
            "expression": "CALCULATE(AVERAGE(Postings[Lower amount]), KEEPFILTERS(Postings[Pay period] = \"Hour\"))",
            "formatString": "$#,0.00"
          },
          {
            "name": "Average hourly upper",
            "expression": "CALCULATE(AVERAGE(Postings[Upper amount]), KEEPFILTERS(Postings[Pay period] = \"Hour\"))",
            "formatString": "$#,0.00"
          },
          {
            "name": "Median hourly lower",
            "expression": "CALCULATE(MEDIAN(Postings[Lower amount]), KEEPFILTERS(Postings[Pay period] = \"Hour\"))",
            "formatString": "$#,0.00"
          },
          {
            "name": "Median hourly upper",
            "expression": "CALCULATE(MEDIAN(Postings[Upper amount]), KEEPFILTERS(Postings[Pay period] = \"Hour\"))",
            "formatString": "$#,0.00"
          },
          {
            "name": "Data coverage",
            "expression": "VAR firstMonth = CALCULATE(MIN(Postings[Period date]),REMOVEFILTERS())\nVAR lastMonth = CALCULATE(MAX(Postings[Period date]),REMOVEFILTERS())\nRETURN IF(ISBLANK(firstMonth),\"No data loaded\",\n    IF(firstMonth=lastMonth,FORMAT(lastMonth,\"MMM yyyy\",\"en-CA\"),\n        FORMAT(firstMonth,IF(YEAR(firstMonth)=YEAR(lastMonth),\"MMM\",\"MMM yyyy\"),\"en-CA\") & \" – \" & FORMAT(lastMonth,\"MMM yyyy\",\"en-CA\")))"
          },
          {
            "name": "Occupation detail heading",
            "expression": "SELECTEDVALUE(Postings[Occupation and NOC],\"All selected occupations\")"
          },
          {
            "name": "Full-time share",
            "expression": "DIVIDE(CALCULATE([Location records],KEEPFILTERS(Postings[Employment type]=\"Full time\")),[Location records])",
            "formatString": "0.0%"
          },
          {
            "name": "Province count colour",
            "expression": "VAR recordsHere = [Location records]\nRETURN SWITCH(TRUE(), ISBLANK(recordsHere),\"#F0F3F1\",recordsHere<1000,\"#DAE9E1\",\n    recordsHere<5000,\"#A4CEC0\",recordsHere<10000,\"#67AE99\",recordsHere<25000,\"#358B79\",\n    recordsHere<40000,\"#12685E\",\"#164C47\")"
          },
          {
            "name": "Monthly change",
            "expression": "VAR d = MAX(Postings[Period date])\nVAR prior = EDATE(d,-1)\nVAR currentCount = CALCULATE([Location records],REMOVEFILTERS(Postings[Month]),Postings[Period date]=d)\nVAR priorCount = CALCULATE([Location records],REMOVEFILTERS(Postings[Month]),Postings[Period date]=prior)\nRETURN DIVIDE(currentCount-priorCount,priorCount)",
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Yes",
            "expression": "SWITCH(SELECTEDVALUE(Indicators[Indicator]),\"Virtual work\", CALCULATE([Location records],KEEPFILTERS(Postings[Telework flag]=\"Yes\")),\n\"Weekend\", CALCULATE([Location records],KEEPFILTERS(Postings[Weekend flag]=\"Yes\")),\n\"Evening\", CALCULATE([Location records],KEEPFILTERS(Postings[Evening flag]=\"Yes\")),\n\"Dental benefit\", CALCULATE([Location records],KEEPFILTERS(Postings[Dental flag]=\"Yes\")),\n\"Medical benefit\", CALCULATE([Location records],KEEPFILTERS(Postings[Medical flag]=\"Yes\")),\n\"Permanent term\", CALCULATE([Location records],KEEPFILTERS(Postings[Employment term]=\"Permanent employment\")))",
            "formatString": "#,0"
          },
          {
            "name": "Displayed Yes",
            "expression": "IF(HASONEVALUE(Indicators[Indicator]) && [Location records]>0,COALESCE([Yes],0))",
            "formatString": "#,0"
          },
          {
            "name": "No",
            "expression": "SWITCH(SELECTEDVALUE(Indicators[Indicator]),\"Virtual work\", CALCULATE([Location records],KEEPFILTERS(Postings[Telework flag]=\"No\")),\n\"Weekend\", CALCULATE([Location records],KEEPFILTERS(Postings[Weekend flag]=\"No\")),\n\"Evening\", CALCULATE([Location records],KEEPFILTERS(Postings[Evening flag]=\"No\")),\n\"Dental benefit\", CALCULATE([Location records],KEEPFILTERS(Postings[Dental flag]=\"No\")),\n\"Medical benefit\", CALCULATE([Location records],KEEPFILTERS(Postings[Medical flag]=\"No\")),\n\"Permanent term\", CALCULATE([Location records],KEEPFILTERS(NOT(Postings[Employment term] IN {\"Permanent employment\",\"Not recorded\"}))))",
            "formatString": "#,0"
          },
          {
            "name": "Displayed No",
            "expression": "IF(HASONEVALUE(Indicators[Indicator]) && [Location records]>0,COALESCE([No],0))",
            "formatString": "#,0"
          },
          {
            "name": "Not recorded",
            "expression": "SWITCH(SELECTEDVALUE(Indicators[Indicator]),\"Virtual work\", CALCULATE([Location records],KEEPFILTERS(Postings[Telework flag]=\"Not recorded\")),\n\"Weekend\", CALCULATE([Location records],KEEPFILTERS(Postings[Weekend flag]=\"Not recorded\")),\n\"Evening\", CALCULATE([Location records],KEEPFILTERS(Postings[Evening flag]=\"Not recorded\")),\n\"Dental benefit\", CALCULATE([Location records],KEEPFILTERS(Postings[Dental flag]=\"Not recorded\")),\n\"Medical benefit\", CALCULATE([Location records],KEEPFILTERS(Postings[Medical flag]=\"Not recorded\")),\n\"Permanent term\", CALCULATE([Location records],KEEPFILTERS(Postings[Employment term]=\"Not recorded\")))",
            "formatString": "#,0"
          },
          {
            "name": "Displayed Not recorded",
            "expression": "IF(HASONEVALUE(Indicators[Indicator]) && [Location records]>0,COALESCE([Not recorded],0))",
            "formatString": "#,0"
          },
          {
            "name": "Top occupation records",
            "expression": "VAR __EligibleCategories =\n    FILTER(ALLSELECTED(Postings[Occupation and NOC]), Postings[Occupation and NOC] <> \"Not recorded\" && [Location records] > 0)\nVAR __TopCategories =\n    TOPN(10, __EligibleCategories, [Location records], DESC, Postings[Occupation and NOC], ASC)\nRETURN IF(CONTAINS(__TopCategories, Postings[Occupation and NOC], SELECTEDVALUE(Postings[Occupation and NOC])), [Location records])",
            "formatString": "#,0"
          },
          {
            "name": "Top city records",
            "expression": "VAR __EligibleCategories =\n    FILTER(ALLSELECTED(Postings[City and province]), Postings[City and province] <> \"Not recorded\" && [Location records] > 0)\nVAR __TopCategories =\n    TOPN(10, __EligibleCategories, [Location records], DESC, Postings[City and province], ASC)\nRETURN IF(CONTAINS(__TopCategories, Postings[City and province], SELECTEDVALUE(Postings[City and province])), [Location records])",
            "formatString": "#,0"
          },
          {
            "name": "Hourly pay in leading occupations",
            "expression": "VAR __EligibleCategories =\n    FILTER(ALLSELECTED(Postings[Occupation and NOC]), Postings[Occupation and NOC] <> \"Not recorded\" && [Hourly records] > 0)\nVAR __TopCategories =\n    TOPN(10, __EligibleCategories, [Hourly records], DESC, Postings[Occupation and NOC], ASC)\nRETURN IF(CONTAINS(__TopCategories, Postings[Occupation and NOC], SELECTEDVALUE(Postings[Occupation and NOC])), [Average hourly midpoint])",
            "formatString": "$#,0.00"
          },
          {
            "name": "Province leading records",
            "expression": "VAR __Candidates=FILTER(ALLSELECTED(Postings[Province]),[Location records]>0)\nVAR __DisplayRows=TOPN(7,__Candidates,[Location records],DESC,Postings[Province],ASC)\nRETURN IF(CONTAINS(__DisplayRows,Postings[Province],SELECTEDVALUE(Postings[Province])),[Location records])",
            "formatString": "#,0"
          },
          {
            "name": "Province leading openings",
            "expression": "IF(NOT ISBLANK([Province leading records]),[Advertised openings])",
            "formatString": "#,0"
          },
          {
            "name": "Province remaining records",
            "expression": "VAR __Candidates=FILTER(ALLSELECTED(Postings[Province]),[Location records]>0)\nVAR __DisplayRows=EXCEPT(__Candidates,TOPN(7,__Candidates,[Location records],DESC,Postings[Province],ASC))\nRETURN IF(CONTAINS(__DisplayRows,Postings[Province],SELECTEDVALUE(Postings[Province])),[Location records])",
            "formatString": "#,0"
          },
          {
            "name": "Province remaining openings",
            "expression": "IF(NOT ISBLANK([Province remaining records]),[Advertised openings])",
            "formatString": "#,0"
          },
          {
            "name": "Province scale maximum",
            "expression": "1.24*MAXX(FILTER(ALLSELECTED(Postings[Province]),[Location records]>0),[Location records])",
            "formatString": "#,0"
          },
          {
            "name": "City leading records",
            "expression": "VAR __Candidates=FILTER(ALLSELECTED(Postings[City and province]),[Location records]>0 && Postings[City and province]<>\"Not recorded\")\nVAR __DisplayRows=TOPN(5,__Candidates,[Location records],DESC,Postings[City and province],ASC)\nRETURN IF(CONTAINS(__DisplayRows,Postings[City and province],SELECTEDVALUE(Postings[City and province])),[Location records])",
            "formatString": "#,0"
          },
          {
            "name": "City leading openings",
            "expression": "IF(NOT ISBLANK([City leading records]),[Advertised openings])",
            "formatString": "#,0"
          },
          {
            "name": "City remaining records",
            "expression": "VAR __Candidates=FILTER(ALLSELECTED(Postings[City and province]),[Location records]>0 && Postings[City and province]<>\"Not recorded\")\nVAR __DisplayRows=EXCEPT(TOPN(10,__Candidates,[Location records],DESC,Postings[City and province],ASC),TOPN(5,__Candidates,[Location records],DESC,Postings[City and province],ASC))\nRETURN IF(CONTAINS(__DisplayRows,Postings[City and province],SELECTEDVALUE(Postings[City and province])),[Location records])",
            "formatString": "#,0"
          },
          {
            "name": "City remaining openings",
            "expression": "IF(NOT ISBLANK([City remaining records]),[Advertised openings])",
            "formatString": "#,0"
          },
          {
            "name": "City scale maximum",
            "expression": "1.24*MAXX(FILTER(ALLSELECTED(Postings[City and province]),[Location records]>0 && Postings[City and province]<>\"Not recorded\"),[Location records])",
            "formatString": "#,0"
          },
          {
            "name": "Hourly range graphic",
            "expression": "VAR upperScale = MAXX(ALLSELECTED(Postings[Province]),[Average hourly upper])\nVAR l = 4+INT(140*DIVIDE([Average hourly lower],upperScale,0))\nVAR u = 4+INT(140*DIVIDE([Average hourly upper],upperScale,0))\nVAR m = 4+INT(140*DIVIDE([Average hourly midpoint],upperScale,0))\nRETURN IF([Hourly records]>0,\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='18'><path d='M4 9H144' stroke='%23D6E0DB'/><path d='M\"&l&\" 9H\"&u&\"' stroke='%2372978C' stroke-width='4'/><circle cx='\"&m&\"' cy='9' r='4' fill='%2308675F'/></svg>\")",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "Education colour key",
            "expression": "VAR __labelsInScope = VALUES(Postings[Education label])\nVAR __orderedLabels = ADDCOLUMNS(__labelsInScope,\"@order\",SWITCH(Postings[Education label],\"Secondary school\",1,\"No degree or diploma\",2,\"College / CEGEP\",3,\"College, 1–2 years\",4,\"Other trades certificate\",5,\"Bachelor’s degree\",6,\"College, 3–<12 months\",7,\"Registered apprenticeship\",8,\"Professional degree\",9,\"Master’s degree\",10,\"Doctorate\",11,\"Not recorded\",12,99))\nVAR __perColumn = MAX(1,ROUNDUP(COUNTROWS(__orderedLabels)/3,0))\nRETURN IF([Location records]>0,\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='620' height='\" & (__perColumn*24+6) & \"'>\" &\n    CONCATENATEX(__orderedLabels,\n        VAR __nm = Postings[Education label]\n        VAR __ord = [@order]\n        VAR __pos = COUNTROWS(FILTER(__orderedLabels,[@order]<__ord || ([@order]=__ord && Postings[Education label]<__nm)))+0\n        VAR __x = 2+207*INT(__pos/__perColumn)\n        VAR __y = 3+24*MOD(__pos,__perColumn)\n        VAR __labelText = SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(__nm,\"&\",\"&amp;\"),\"<\",\"&lt;\"),\">\",\"&gt;\")\n        RETURN \"<rect x='\" & __x & \"' y='\" & (__y+3) & \"' width='12' height='10' rx='2' fill='\" &\n          SWITCH(__nm,\"Secondary school\",\"%2312766C\",\"No degree or diploma\",\"%23516D9B\",\"College / CEGEP\",\"%2398672F\",\"College, 1–2 years\",\"%23735899\",\"Other trades certificate\",\"%234F8759\",\"Bachelor’s degree\",\"%23A65B70\",\"College, 3–<12 months\",\"%23247F9D\",\"Registered apprenticeship\",\"%23977D3D\",\"Professional degree\",\"%23445B82\",\"Master’s degree\",\"%23A56A45\",\"Doctorate\",\"%2358695A\",\"Not recorded\",\"%23C4CEC9\",\"%23586862\") & \"'/><text x='\" & (__x+19) & \"' y='\" & (__y+13) &\n          \"' font-family='Segoe UI, sans-serif' font-size='12' fill='%232F4847'>\" & __labelText & \"</text>\",\n        \"\") & \"</svg>\")",
            "dataCategory": "ImageUrl"
          }
        ],
        "partitions": [
          {
            "name": "Postings",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = MySQL.Database(\"127.0.0.1:3307\", \"jobbank\", [ReturnSingleDatabase=true]),",
                "    Postings = Source{[Schema=\"jobbank\", Item=\"powerbi_postings\"]}[Data]",
                "in",
                "    Postings"
              ]
            }
          }
        ]
      },
      {
        "name": "Indicators",
        "columns": [
          {
            "name": "Indicator",
            "dataType": "string",
            "sourceColumn": "Indicator",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Indicators",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "#table(type table [Indicator=text], {{\"Virtual work\"},{\"Weekend\"},{\"Evening\"},{\"Dental benefit\"},{\"Medical benefit\"},{\"Permanent term\"}})"
              ]
            }
          }
        ]
      }
    ]
  }
}
